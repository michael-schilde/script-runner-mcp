{
  "name": "script-runner-mcp",
  "version": "0.1.0",
  "description": "An MCP server that lets an AI agent run only the local scripts you declared, with checked arguments and no shell.",
  "type": "module",
  "bin": {
    "script-runner-mcp": "src/cli.js"
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint ."
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai-agents",
    "automation"
  ],
  "author": "Michael Schilde",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael-schilde/script-runner-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/michael-schilde/script-runner-mcp/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
